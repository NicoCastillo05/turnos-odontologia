# Plantilla de variables de entorno — Turnos Odontología
# Copiar a .env y completar con valores propios. NUNCA versionar el archivo .env resultante.
# Los valores de abajo son placeholders de desarrollo, no secretos reales.

# Base de datos H2 embebida (modo archivo). La carpeta data/ ya está en .gitignore.
DATABASE_URL=jdbc:h2:file:./data/turnosdb
DATABASE_USER=sa
DATABASE_PASSWORD=

# Consola H2 (sólo se habilita con el perfil dev)
H2_CONSOLE_ENABLED=true

# Autenticación (C-03). Reemplazar por un valor aleatorio fuera de desarrollo.
JWT_SECRET=change-me-dev-only-not-for-production
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Notificaciones (C-12)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Pagos (C-11)
MP_ACCESS_TOKEN=

# Cliente
FRONTEND_URL=http://localhost:5173
